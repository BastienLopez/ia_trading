# Runtime local securise. Les valeurs secretes restent vides et ne sont jamais versionnees.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
ALLOW_SYNTHETIC_DATA=false
API_BIND_HOST=127.0.0.1
API_PORT=8000
APP_DEBUG=false
WEB_SECRET_KEY=

# Services locaux existants
DATABASE_URL=postgresql://postgres:change-me@db:5432/trading
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
API_URL=http://localhost:8000

# Exchanges et integrations existantes : renseigner localement seulement si necessaire.
BINANCE_API_KEY=
BINANCE_API_SECRET=
CRYPTO_PANIC_AUTH_TOKEN=
CRYPTOPANIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Chemins de modeles
SENTIMENT_MODEL_PATH=models/sentiment
PREDICTION_MODEL_PATH=models/prediction
ML_MODEL_PATH=models/trading

# Parametres de trading existants
RISK_PERCENTAGE=1
MAX_POSITION_SIZE=5000
STOP_LOSS_PERCENTAGE=2
TAKE_PROFIT_PERCENTAGE=6
